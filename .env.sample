DATABASE_URL="db url"
JWT_SECRET_KEY="token"
# Used to encrypt/decrypt devicePassword and appPin on keeper records.
# Keep this stable — changing it breaks decryption of existing credentials.
CREDENTIAL_ENCRYPTION_KEY="token"
# Strato SMTP (all app emails)
SMTP_HOST="smtp.strato.de"
SMTP_PORT=465
SMTP_USER="noreply@legacy-keeper.app"
SMTP_PASSWORD="your-strato-mailbox-password"
SMTP_FROM="noreply@legacy-keeper.app"
UPLOAD_FOLDER = public/images
AppName='Your APP Name'
PORT=8080
PUBLIC_BASE_URL=https://faisal8080.merinasib.shop
 endpoint_secret="Secret"

# Stripe Checkout (hosted) payments
STRIPE_SECRET_KEY="sk_test_..."          # NEVER expose to the frontend
STRIPE_WEBHOOK_SECRET="whsec_..."        # from the Stripe CLI / dashboard
CLIENT_URL="http://localhost:5173"       # the frontend origin (for redirects + CORS)
PRODUCT_PRICE_ID="price_..."             # Stripe Price id for the product being sold